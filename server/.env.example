# Database Configuration
MONGODB_URI=mongodb://localhost:27017/festify

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match the Authorized redirect URI in Google Cloud Console (server URL, not the SPA):
GOOGLE_CALLBACK_URL=https://festify-production-524b.up.railway.app/api/auth/google/callback

# Public server URL (used if GOOGLE_CALLBACK_URL is omitted)
SERVER_PUBLIC_URL=https://festify-production-524b.up.railway.app

# Email Configuration (Nodemailer)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password

# Server Configuration
PORT=5000
# Browser origin for CORS + post-OAuth redirect (your deployed client)
CLIENT_URL=https://festify-client-production.up.railway.app
